<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <TextView
        android:id="@+id/tvRoomListTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản lý danh sách phòng"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/navy_deep"
        android:layout_marginBottom="16dp"/>

    <!-- Nút thêm phòng -->
    <Button
        android:id="@+id/btnAddRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ THÊM PHÒNG MỚI"
        android:backgroundTint="@color/navy_deep"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:onClick="onAddRoomClick" />

    <ListView
        android:id="@+id/lvDanhSachPhong"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="8dp"
        android:divider="@android:color/transparent"/>

</LinearLayout>
