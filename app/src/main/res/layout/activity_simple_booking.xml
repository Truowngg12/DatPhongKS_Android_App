<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thông tin đặt phòng"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="24dp"
        android:gravity="center"/>

    <!-- ID Tên khách -->
    <EditText
        android:id="@+id/edtTenKhach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên khách hàng"
        android:inputType="textPersonName"
        android:padding="14dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="16dp"/>

    <!-- ID Số điện thoại -->
    <EditText
        android:id="@+id/edtSoDienThoai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số điện thoại"
        android:inputType="phone"
        android:padding="14dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="16dp"/>

    <!-- ID Số ngày -->
    <EditText
        android:id="@+id/edtSoNgay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số ngày thuê (vd: 2)"
        android:inputType="number"
        android:padding="14dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="32dp"/>

    <!-- ID Nút Xác nhận -->
    <Button
        android:id="@+id/btnXacNhan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xác nhận đặt phòng"
        android:textSize="18sp"
        android:padding="14dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>